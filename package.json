{
  "version": "0.5.8",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker.ts",
    "lint": "eslint",
    "db:migrate": "node database/migrate.mjs",
    "storage:configure-cors": "node scripts/configure-r2-cors.mjs",
    "storage:optimize-generated-videos": "node --import tsx src/scripts/optimize-generated-videos.ts",
    "collaboration:compact": "node scripts/compact-collaboration-document.mjs",
    "package:compose": "node scripts/compose-edition-package.mjs",
    "package:verify": "node scripts/compose-edition-package.mjs --check",
    "test:browser": "playwright test",
    "test": "SCENELITH_DEPLOYMENT_TYPE=selfhost SCENELITH_USAGE_MODE=bring_your_own node scripts/run-tests.mjs --edition selfhost",
    "selfhost:init": "./scenelith init",
    "selfhost:doctor": "./scenelith doctor",
    "selfhost:backup": "./scenelith backup",
    "selfhost:restore": "./scenelith restore",
    "selfhost:e2e": "node scripts/selfhost-e2e.mjs",
    "selfhost:load-proof": "node scripts/selfhost-load-proof.mjs",
    "selfhost:audit": "node scripts/audit-selfhost-snapshot.mjs",
    "selfhost:bundle": "node scripts/build-selfhost-bundle.mjs",
    "selfhost:config": "./scenelith config",
    "selfhost:up": "./scenelith start",
    "selfhost:down": "./scenelith stop",
    "selfhost:pull:infrastructure": "docker compose --env-file deploy/selfhost/.env -f deploy/selfhost/compose.yaml pull postgres redis gateway",
    "selfhost:build": "docker compose --env-file deploy/selfhost/.env -f deploy/selfhost/compose.yaml build frameflow",
    "selfhost:up:source": "npm run selfhost:doctor && npm run selfhost:pull:infrastructure && npm run selfhost:build && docker compose --env-file deploy/selfhost/.env -f deploy/selfhost/compose.yaml up -d --no-build --pull never"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1103.0",
    "@aws-sdk/s3-request-presigner": "^3.1104.0",
    "@hocuspocus/extension-redis": "^4.6.0",
    "@hocuspocus/provider": "^4.6.0",
    "@hocuspocus/server": "^4.6.0",
    "@xyflow/react": "^12.11.2",
    "bcryptjs": "^3.0.3",
    "croner": "^10.0.1",
    "ioredis": "^5.11.1",
    "jose": "^6.2.7",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "next": "16.2.12",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.3",
    "tsx": "^4.23.5",
    "ws": "^8.21.3",
    "yjs": "^13.6.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true
  },
  "name": "scenelith",
  "description": "Open visual AI creation and automation canvas with first-class self-hosting",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Scenelith/scenelith.git"
  },
  "bugs": {
    "url": "https://github.com/Scenelith/scenelith/issues"
  },
  "homepage": "https://github.com/Scenelith/scenelith#readme"
}
