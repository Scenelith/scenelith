# Generated secrets are written by `npm run selfhost:init`.
POSTGRES_DB=scenelith
POSTGRES_USER=scenelith
POSTGRES_PASSWORD=
SESSION_SECRET=
COLLABORATION_JWT_SECRET=
COLLABORATION_INTERNAL_SECRET=

# Every application role runs from this one published image and release tag.
# Change the version only when following a documented upgrade or rollback.
SCENELITH_VERSION=0.3.1
SCENELITH_APP_IMAGE=ghcr.io/scenelith/scenelith

# These values identify the public self-hosted runtime.
SCENELITH_DEPLOYMENT_TYPE=selfhost
SCENELITH_USAGE_MODE=bring_your_own

# Localhost works over HTTP. For a public server set both values to the same
# HTTPS origin/domain; Caddy obtains and renews the certificate automatically.
SCENELITH_HOST=http://localhost
PUBLIC_URL=http://localhost
COOKIE_SECURE=false
SCENELITH_REGISTRATION_MODE=owner_only
HTTP_PORT=80
HTTPS_PORT=443

# Add the providers you use. Kie currently powers generation models and
# OpenRouter powers Assistant and TikTok automation planning.
# TikTok media imports currently use the public Tikwm resolver and require no
# TikTok account, TikTok cookies, or additional provider key.
KIE_API_KEY=
KIE_WEBHOOK_HMAC_KEY=
OPENROUTER_API_KEY=

# Local storage works immediately. Set STORAGE_PROVIDER=s3 to use MinIO,
# AWS S3, Backblaze, DigitalOcean Spaces or another S3-compatible service.
STORAGE_PROVIDER=local
# Leave blank for AWS S3. Set an HTTPS endpoint for MinIO, Backblaze,
# DigitalOcean Spaces, or another S3-compatible service.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRIVATE_BUCKET=scenelith-private
S3_PUBLIC_BUCKET=scenelith-public
S3_FORCE_PATH_STYLE=false
STORAGE_CORS_ORIGINS=

SELFHOST_GENERATION_CONCURRENCY=8
TIKTOK_AUTOMATION_CONCURRENCY=3
